# Copy to .env and fill in keys from https://www.decisionlayer.ai/settings/api-keys
# Keys are shown only once. Prefix is dvarb_.

# Used when --profile is omitted
DECISIONLAYER_API_KEY=

# Dual-party testing: claimant files the case, respondent answers it
DECISIONLAYER_API_KEY_CLAIMANT=
DECISIONLAYER_API_KEY_RESPONDENT=

# Optional. Default is production, for a live contract or consent filing.
# DECISIONLAYER_BASE_URL=https://www.decisionlayer.ai
DECISIONLAYER_BASE_URL=https://www.decisionlayer.ai

# Practice filings use a test key on staging:
# DECISIONLAYER_BASE_URL=https://staging.decisionlayer.ai
# Simulations also use that staging host, with a production key (dvarb_...), not a test key.
# Test keys are created at https://staging.decisionlayer.ai/settings/test-api-keys.
